{
  "name": "straight-jacket",
  "version": "1.1.0",
  "type": "module",
  "description": "A tiny MCP, CLI, and plugin for human-protected repo files.",
  "author": "Daniel Cassil <me@danielcassil.com>",
  "homepage": "https://github.com/dcassil/straight-jacket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcassil/straight-jacket.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "cli",
    "guardrails",
    "protected-files",
    "security"
  ],
  "bin": {
    "straight-jacket": "bin/straight-jacket.mjs",
    "straight-jacket-mcp": "bin/straight-jacket-mcp.mjs"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "bin",
    "codex",
    "docs",
    "skills",
    "src",
    "templates",
    "CHANGELOG.md",
    "LICENSE",
    "PRODUCT_VISION.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/unit/*.test.mjs test/contract/*.test.mjs test/security/*.test.mjs test/guardrails/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:contract": "node --test test/contract/*.test.mjs test/security/*.test.mjs",
    "test:guardrails": "node --test test/guardrails/*.test.mjs",
    "guardrails": "node scripts/guardrails/boundary-check.mjs && node scripts/guardrails/coverage-check.mjs && node scripts/guardrails/quality-check.mjs"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "dependencies": {
    "straight-jacket": "^1.0.0"
  }
}
